generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum PaymentStatus {
  SUCCEEDED
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  fullName     String           @db.VarChar(120)
  email        String           @unique @db.VarChar(254)
  passwordHash String
  avatarUrl    String?
  bio          String?          @db.VarChar(2000)
  role         Role             @default(USER)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  sessions     Session[]
  courses      Course[]
  cartItems    CartItem[]
  orders       Order[]
  enrollments  Enrollment[]
  progress     LessonProgress[]
  reviews      Review[]
  certificates Certificate[]
  assets       Asset[]

  @@index([role])
  @@index([createdAt])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(160)
  description String?  @db.VarChar(2000)
  courses     Course[]
}

model Course {
  level         String        @default("All levels")
  outcomes      String[]      @default([])
  requirements  String[]      @default([])
  instructorRole String       @default("Instructor")
  id            String        @id @default(uuid()) @db.Uuid
  title         String        @db.VarChar(200)
  slug          String        @unique @db.VarChar(220)
  description   String        @db.Text
  thumbnailUrl  String?
  instructorId  String        @db.Uuid
  categoryId    String        @db.Uuid
  price         Decimal       @db.Decimal(14, 2)
  discountPrice Decimal?      @db.Decimal(14, 2)
  published     Boolean       @default(false)
  deletedAt     DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  instructor    User          @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sections      Section[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  enrollments   Enrollment[]
  reviews       Review[]
  certificates  Certificate[]

  @@index([instructorId])
  @@index([categoryId, published, createdAt])
  @@index([published, deletedAt, createdAt])
  @@index([price])
}

model Section {
  id       String   @id @default(uuid()) @db.Uuid
  courseId String   @db.Uuid
  title    String   @db.VarChar(200)
  position Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@unique([courseId, position])
}

model Lesson {
  id              String           @id @default(uuid()) @db.Uuid
  sectionId       String           @db.Uuid
  title           String           @db.VarChar(200)
  description     String?          @db.VarChar(10000)
  // Private provider asset identifier, NEVER a publicly accessible storage URL.
  videoUrl        String?
  durationSeconds Int              @default(0)
  position        Int
  isPreview       Boolean          @default(false)
  section         Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]

  @@unique([sectionId, position])
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  courseId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  status         OrderStatus @default(PENDING_PAYMENT)
  subtotal       Decimal     @db.Decimal(14, 2)
  discountTotal  Decimal     @db.Decimal(14, 2)
  total          Decimal     @db.Decimal(14, 2)
  currency       String      @default("UZS") @db.Char(3)
  idempotencyKey String      @db.VarChar(100)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  payments       Payment[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                  String  @id @default(uuid()) @db.Uuid
  orderId             String  @db.Uuid
  courseId            String  @db.Uuid
  courseTitleSnapshot String  @db.VarChar(200)
  priceSnapshot       Decimal @db.Decimal(14, 2)
  discountSnapshot    Decimal @db.Decimal(14, 2)
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course              Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([orderId, courseId])
  @@index([courseId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @unique @db.Uuid
  provider          String        @db.VarChar(40)
  providerPaymentId String        @db.VarChar(200)
  amount            Decimal       @db.Decimal(14, 2)
  currency          String        @db.Char(3)
  status            PaymentStatus
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerPaymentId])
}

model Enrollment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  courseId   String   @db.Uuid
  source     String   @default("PAYMENT") @db.VarChar(20)
  enrolledAt DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  lessonId            String    @db.Uuid
  completed           Boolean   @default(false)
  completedAt         DateTime? @db.Timestamptz(3)
  lastPositionSeconds Int       @default(0)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  courseId  String   @db.Uuid
  rating    Int
  comment   String   @db.VarChar(3000)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, hidden, createdAt])
}

model Certificate {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  courseId        String   @db.Uuid
  issuedAt        DateTime @default(now()) @db.Timestamptz(3)
  certificateCode String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId])
}

// Small re-encoded avatars can persist without an external object store.
model Asset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  bytes     Bytes
  mimeType  String   @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Shared PostgreSQL counters enforce limits across Node processes.
model RateLimit {
  key       String   @id @db.VarChar(100)
  hits      Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}
