NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://dars:dars_dev_only@localhost:5432/dars?schema=public&connection_limit=10
FRONTEND_URL=http://localhost:5173
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
DEV_ENROLLMENT_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_ADAPTER_MODULE=
STORAGE_PROVIDER=database
STORAGE_ADAPTER_MODULE=
VIDEO_PROVIDER=disabled
VIDEO_ADAPTER_MODULE=
MEDIA_LOCAL_DIR=.local/media
# Must be a separate disposable PostgreSQL database with 'test' in its name.
TEST_DATABASE_URL=postgresql://dars:dars_dev_only@localhost:5432/dars_test?schema=public
