{
  "name": "@dars/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:check": "node scripts/check-db.js",
    "admin:create": "node scripts/create-admin.js",
    "sessions:prune": "node scripts/prune.js",
    "check": "node scripts/check.js",
    "test": "vitest run tests/unit.test.js",
    "test:integration": "node scripts/test-integration.js",
    "local:setup": "node scripts/local-setup.js",
    "db:local": "node scripts/local-db.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "vitest": "^5.1.0",
    "embedded-postgres": "18.6.0-beta.19"
  }
}
